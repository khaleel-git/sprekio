{
  "manifest_version": 3,
  "name": "Sprekio - Language Reactor Clone",
  "version": "1.0.0",
  "description": "Learn languages with dual subtitles and a hover dictionary on YouTube.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://sprekio.khaleel.eu/*", "http://localhost:3000/*", "http://localhost:5173/*"],
      "js": ["src/content/index.tsx"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/interceptor.ts"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "*://*.googlevideo.com/*",
    "https://sprekio-backend.khaleel-eu.workers.dev/*"
  ],
  "oauth2": {
    "client_id": "320928767182-lhce801v9v379b1eq8ai0c5ca2ve9q7d.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "externally_connectable": {
    "matches": [
      "https://sprekio.khaleel.eu/*",
      "http://localhost:3000/*",
      "http://localhost:5173/*"
    ]
  }
}
